# --- database ---
POSTGRES_USER=peach
POSTGRES_PASSWORD=peach
POSTGRES_DB=peach
POSTGRES_PORT=543

# --- backend ---
DATABASE_URL=postgresql+asyncpg://peach:peach@db:5432/peach
BACKEND_PORT=8000
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# --- frontend ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

# --- aws (make deploy-backend / domain-backend / deploy-frontend / domain) ---
# Everything lands in us-east-1, tagged PROJECT_NAME=<PROJECT_NAME>. Every
# other knob has a default in the scripts or templates and can still be set
# here to override it.
AWS_REGION=us-east-1
PROJECT_NAME=peach
# Blank keys fall back to AWS_PROFILE, SSO, or an instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=

# The deployed frontend's origin, once it has one.
API_CORS_ORIGINS=*


# --- sign-in (make deploy-auth) ---
# A Web application OAuth client from Google Cloud. Its JavaScript origin is
# https://<prefix>.auth.<region>.amazoncognito.com and its redirect URI is the
# same plus /oauth2/idpresponse. The secret stays in this gitignored file.
COGNITO_DOMAIN_PREFIX=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- written by the scripts, not by hand ---
# make deploy-backend / make domain-backend: the API URL. make deploy-frontend builds against it.
BACKEND_URL=
# make domain DOMAIN=app.example.com: the frontend's custom domain.
DOMAIN_NAME=
# make domain-backend DOMAIN=api.example.com: the API's custom domain (ECS).
API_DOMAIN_NAME=

# --- ecs backend (make deploy-backend), all optional ---
# ECS_CPU=256
# ECS_MEMORY=512
# ECS_DESIRED_COUNT=1
# DB_INSTANCE_CLASS=db.t4g.micro
